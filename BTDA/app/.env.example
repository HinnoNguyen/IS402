# Copy thành file .env (đã có trong .gitignore, KHÔNG commit) rồi điền giá trị.
# Để trống *_URL -> phần đó chạy chế độ MOCK (dữ liệu giả).
# Lấy URL/key bằng az (xem README.md), không chép key vào bất kỳ file nào khác.

# Endpoint phân loại ý định (Vũ – T32/T33)
CLASSIFIER_URL=
CLASSIFIER_KEY=
# Để trống = endpoint tự chia traffic blue/green; điền "blue"/"green" để gọi thẳng 1 deployment
CLASSIFIER_DEPLOYMENT=

# Endpoint chatbot Prompt Flow (Bằng – T34)
CHAT_URL=
CHAT_KEY=
CHAT_DEPLOYMENT=

# Cosmos DB lưu phản hồi Thích/Không thích (Bảo – T38). KHÔNG dùng key: xác thực bằng Entra ID
# (local: az login; App Service: managed identity của web app). Để trống -> lưu tạm trong bộ nhớ (MOCK).
COSMOS_ENDPOINT=
COSMOS_DATABASE=credit-assistant
COSMOS_CONTAINER=feedback

# Tùy chọn
# MOCK_MODE=true                 # ép cả 2 phần chạy MOCK dù đã có URL
# ENDPOINT_TIMEOUT_SECONDS=60
